# ============================================================
# Regras Customizadas Suricata -- Rede de Farmacias
# Alinhadas aos TTPs MITRE ATT&CK do relatorio Sprint 1
# ============================================================

# --- Cenario 1: Lateral Movement ------------------------------------

alert tcp any any -> 172.21.0.0/24 any (msg:"[FARMACIA] Port Scan Detectado - Possivel Lateral Movement"; flags:S; threshold: type threshold, track by_src, count 20, seconds 10; classtype:network-scan; sid:1000001; rev:1;)

alert tcp 172.20.0.0/24 any -> 172.21.0.0/24 22 (msg:"[FARMACIA] Acesso SSH da DMZ para Rede Interna - Lateral Movement"; flags:S; classtype:attempted-admin; sid:1000002; rev:1;)

alert icmp any any -> 172.21.0.0/24 any (msg:"[FARMACIA] ICMP Sweep - Reconhecimento de Rede Interna"; itype:8; threshold: type threshold, track by_src, count 10, seconds 5; classtype:network-scan; sid:1000003; rev:1;)

# --- Cenario 2: Exfiltracao de Dados --------------------------------

alert tcp 172.21.0.0/24 any -> !172.0.0.0/8 21 (msg:"[FARMACIA] ALERTA CRITICO - Tentativa de Exfiltracao via FTP (T1048)"; classtype:policy-violation; sid:1000010; rev:1;)

alert tcp 172.21.0.0/24 any -> !172.0.0.0/8 ![80,443,53,25,587,22] (msg:"[FARMACIA] ALERTA - Conexao Saida em Porta Nao Autorizada (possivel C2 T1041)"; classtype:trojan-activity; sid:1000011; rev:1;)

# --- Cenario 3: Escalacao de Privilegios ----------------------------

alert http any any -> any any (msg:"[FARMACIA] ALERTA CRITICO - Acesso ao Docker Socket via HTTP (T1611)"; http.uri; content:"/containers/"; classtype:attempted-admin; sid:1000020; rev:1;)

# --- Cenario 4: Evasao de Defesas -----------------------------------

alert http any any -> any any (msg:"[FARMACIA] Possivel Payload Ofuscado Base64 em HTTP (T1027)"; http.request_body; pcre:"/^[A-Za-z0-9+\/]{50,}={0,2}$/"; classtype:web-application-attack; sid:1000030; rev:1;)

# --- SQL Injection ---------------------------------------------------

alert http any any -> any any (msg:"[FARMACIA] SQL Injection Attempt - UNION SELECT"; http.uri; content:"UNION"; nocase; http.uri; content:"SELECT"; nocase; classtype:web-application-attack; sid:1000040; rev:1;)