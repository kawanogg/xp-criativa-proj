{
  "realm": "farmacia",
  "enabled": true,
  "displayName": "Rede de Farmácias",
  "displayNameHtml": "<b>Rede de Farmácias</b>",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "admin",         "description": "Administrador do sistema" },
      { "name": "farmaceutico",  "description": "Farmacêutico (acesso a prontuários)" },
      { "name": "cliente",       "description": "Cliente final" }
    ]
  },
  "clients": [
    {
      "clientId": "ecommerce-app",
      "name": "E-commerce Farmácia",
      "enabled": true,
      "publicClient": false,
      "secret": "ecommerce-secret-2026",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost/*",
        "http://ecommerce.farmacia.local/*"
      ],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    }
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "xXSSProtection": "1; mode=block",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "passwordPolicy": "length(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "users": [
    {
      "username": "teste@pucparana.com",
      "email": "teste@pucparana.com",
      "firstName": "Usuario",
      "lastName": "Teste",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Teste@2026",
          "temporary": false
        }
      ],
      "realmRoles": ["cliente"]
    },
    {
